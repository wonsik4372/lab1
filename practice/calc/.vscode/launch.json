    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug calc_static",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/calc_static",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "make all",
            "setupCommands": [
                { "description": "pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]

}